{
  "name": "mard-bead-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-test-fixtures.mjs",
    "palettes:sync": "node scripts/sync-mard-palettes.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "culori": "4.0.2",
    "jspdf": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/culori": "4.0.1",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "oxlint": "1.77.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
